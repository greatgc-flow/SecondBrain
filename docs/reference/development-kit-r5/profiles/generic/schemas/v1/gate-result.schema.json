{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic-dev/schemas/v1/gate-result.schema.json",
  "title": "gate-result",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED",
        "WAIVED",
        "STALE"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "gate",
    "candidate_id",
    "candidate_digest",
    "status",
    "owner",
    "recorded_at",
    "evidence_ref",
    "rationale"
  ],
  "additionalProperties": false
}
