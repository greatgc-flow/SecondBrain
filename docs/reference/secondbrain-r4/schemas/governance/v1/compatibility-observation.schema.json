{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:secondbrain:governance:v1:compatibility-observation",
  "title": "Compatibility Observation",
  "required": [
    "schema_version",
    "observation_id",
    "integration",
    "version",
    "candidate_id",
    "status",
    "checked_at",
    "contract_test_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "integration": {
      "enum": [
        "engram",
        "peerhub",
        "mcp",
        "obsidian",
        "cloud-sync",
        "ai-provider"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "BLOCKED",
        "UNKNOWN",
        "STALE"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "contract_test_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
