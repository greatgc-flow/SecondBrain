{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:secondbrain:governance:v1:improvement-proposal",
  "title": "Improvement Proposal",
  "required": [
    "schema_version",
    "proposal_id",
    "feedback_id",
    "scope",
    "risk_tier",
    "approver",
    "decision",
    "requested_at",
    "rollback_plan"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "approver": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "decision": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1
    },
    "affected_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
