{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:commit-receipt",
  "title": "Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_id",
    "capture_id",
    "object_id",
    "observation_id",
    "acquisition_id",
    "custody_event_id",
    "published_at",
    "writer_device_id",
    "writer_epoch",
    "object_verified_sha256",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^obj-sha256-[0-9a-f]{64}$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "acquisition_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "custody_event_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "writer_device_id": {
      "type": "string",
      "minLength": 1
    },
    "writer_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "object_verified_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "COMMITTED"
    },
    "record_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^brain://(evidence|object|observation|artifact|production|knowledge|context|capture)/[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    }
  }
}
