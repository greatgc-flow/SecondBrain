{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:derivation",
  "title": "Derivation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "derivation_id",
    "parent_uri",
    "output_uri",
    "transform_type",
    "tool",
    "created_at",
    "output_sha256",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "derivation_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "parent_uri": {
      "type": "string",
      "pattern": "^brain://(evidence|object|observation|artifact|production|knowledge|context|capture)/[A-Za-z0-9._-]+$"
    },
    "output_uri": {
      "type": "string",
      "pattern": "^brain://(evidence|object|observation|artifact|production|knowledge|context|capture)/[A-Za-z0-9._-]+$"
    },
    "transform_type": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "time_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "time_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
