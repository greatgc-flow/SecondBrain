{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:fact-assertion",
  "title": "Fact Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "text",
    "epistemic_tier",
    "recorded_at",
    "evidence_refs",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_tier": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "EXTRACTED",
        "ASSERTED",
        "INFERRED",
        "VERIFIED"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^brain://(evidence|object|observation|artifact|production|knowledge|context|capture)/[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "performed_by": {
          "type": "string",
          "minLength": 1
        },
        "report_uri": {
          "type": "string",
          "pattern": "^brain://(evidence|object|observation|artifact|production|knowledge|context|capture)/[A-Za-z0-9._-]+$"
        }
      }
    }
  }
}
