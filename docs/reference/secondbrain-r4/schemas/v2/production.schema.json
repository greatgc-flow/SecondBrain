{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:production",
  "title": "Production",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "production_id",
    "matter_id",
    "created_at",
    "creator",
    "output_sha256",
    "items",
    "purpose"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "production_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "matter_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "object_sha256",
          "output_label",
          "representation"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "object_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_label": {
            "type": "string",
            "minLength": 1
          },
          "representation": {
            "enum": [
              "original_copy",
              "excerpt",
              "transcript",
              "redacted",
              "merged",
              "annotated"
            ]
          },
          "source_page_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "printed_page_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_time_range": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "redaction_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
