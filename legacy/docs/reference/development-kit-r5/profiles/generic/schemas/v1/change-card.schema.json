{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generic-dev/schemas/v1/change-card.schema.json",
  "title": "change-card",
  "type": "object",
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3}$"
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GD-[0-9]{3}$"
      },
      "minItems": 1
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TEST-[0-9]{3}$"
      },
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "observed_effect_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "RED",
        "GREEN",
        "VERIFIED",
        "DEPLOYED",
        "EFFECT_OBSERVED"
      ]
    }
  },
  "required": [
    "change_id",
    "why",
    "scope",
    "requirement_ids",
    "test_ids",
    "owner",
    "rollback",
    "observed_effect_ref",
    "status"
  ],
  "additionalProperties": false
}
