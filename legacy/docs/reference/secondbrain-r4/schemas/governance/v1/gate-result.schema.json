{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:secondbrain:governance:v1:gate-result",
  "title": "Gate Result",
  "required": [
    "schema_version",
    "result_id",
    "candidate_id",
    "gate_id",
    "status",
    "test_catalog_sha256",
    "environment_sha256",
    "observed_at",
    "executor",
    "evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "gate_id": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED",
        "STALE",
        "WAIVED",
        "MANUAL_VERIFIED",
        "INFRA_ERROR"
      ]
    },
    "test_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "executor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "MANUAL_VERIFIED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evidence_ref",
          "reviewer"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
