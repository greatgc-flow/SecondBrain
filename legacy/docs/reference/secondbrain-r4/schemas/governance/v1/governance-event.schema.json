{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:governance:v1:governance-event",
  "title": "Governance Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "stream_id",
    "sequence",
    "previous_event_hash",
    "event_hash",
    "event_type",
    "actor",
    "event_at",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 3
    },
    "stream_id": {
      "type": "string",
      "minLength": 3
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_type": {
      "enum": [
        "CREATED",
        "TRIAGED",
        "CAUSE_ASSIGNED",
        "CHANGE_APPROVED",
        "TEST_LINKED",
        "FIX_IMPLEMENTED",
        "TEST_VERIFIED",
        "DEPLOYED",
        "EFFECT_OBSERVED",
        "CLOSED",
        "REOPENED",
        "RISK_ACCEPTED",
        "STATUS_CHANGED"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "event_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
