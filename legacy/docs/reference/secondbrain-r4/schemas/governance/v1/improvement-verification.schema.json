{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:secondbrain:governance:v1:improvement-verification",
  "title": "Improvement Verification",
  "required": [
    "schema_version",
    "verification_id",
    "feedback_id",
    "candidate_id",
    "baseline_metric",
    "after_metric",
    "population",
    "observation_start",
    "observation_end",
    "decision",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verification_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "baseline_metric": {
      "type": "number"
    },
    "after_metric": {
      "type": "number"
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "observation_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "observation_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decision": {
      "enum": [
        "EFFECTIVE",
        "INEFFECTIVE",
        "INCONCLUSIVE"
      ]
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
