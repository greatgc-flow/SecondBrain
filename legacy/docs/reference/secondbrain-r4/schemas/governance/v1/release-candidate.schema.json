{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:secondbrain:governance:v1:release-candidate",
  "title": "Release Candidate",
  "required": [
    "schema_version",
    "candidate_id",
    "source_sha",
    "artifact_sha256",
    "config_sha256",
    "schema_sha256",
    "test_catalog_sha256",
    "dependency_lock_sha256",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:/-]{2,127}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN",
        "WITHDRAWN"
      ]
    },
    "engram_baseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "peerhub_baseline": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
