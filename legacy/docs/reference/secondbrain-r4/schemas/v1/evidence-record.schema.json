{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/secondbrain/schemas/v1/evidence-record.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "object_id",
    "title",
    "status",
    "erl",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 3
    },
    "object_id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "ARCHIVED",
        "DESTROYED"
      ]
    },
    "erl": {
      "enum": [
        "ERL-0",
        "ERL-1",
        "ERL-2",
        "ERL-3",
        "ERL-4",
        "ERL-5"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
