{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/secondbrain/schemas/v1/snapshot.schema.json",
  "title": "Snapshot Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "brain_id",
    "created_at",
    "status",
    "file_count",
    "total_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 3
    },
    "brain_id": {
      "type": "string",
      "minLength": 3
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "BUILDING",
        "VERIFYING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha512": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
