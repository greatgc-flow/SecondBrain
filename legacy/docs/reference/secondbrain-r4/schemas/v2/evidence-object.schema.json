{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:evidence-object",
  "title": "Evidence Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "sha256",
    "sha512",
    "size_bytes",
    "media_type",
    "sealed_at",
    "vault_relpath",
    "source_fidelity"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "object_id": {
      "type": "string",
      "pattern": "^obj-sha256-[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "vault_relpath": {
      "type": "string",
      "pattern": "^10_Evidence/Vault/objects/sha256/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}/payload$"
    },
    "source_fidelity": {
      "enum": [
        "native_obtained",
        "exported",
        "rendered",
        "screenshot_only",
        "unknown"
      ]
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_type_detection": {
      "enum": [
        "sniffed",
        "declared",
        "unknown"
      ]
    }
  }
}
