{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secondbrain:schema:v2:observation",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "object_id",
    "device_id",
    "capture_id",
    "first_seen_at",
    "ingest_channel",
    "source_type",
    "source_fidelity"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^obj-sha256-[0-9a-f]{64}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ingest_channel": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_fidelity": {
      "enum": [
        "native_obtained",
        "exported",
        "rendered",
        "screenshot_only",
        "unknown"
      ]
    },
    "source_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_claimed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
